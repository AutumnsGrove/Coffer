# Runtime state (on the potato, in the install folder)
/data/
/update-signal/
/.env
/.update-watcher.lock

# Financial data. Never commit any of this.
*.db
*.db-wal
*.db-shm
*.csv
!/testdata/**/*.csv
!/docs/**/*.csv
# Bank statements carry a name, an address and account numbers. Never commit a real one;
# parser fixtures are synthetic text files, not statements.
*.pdf
/statements/
/exports/
/local-data/

# Go
/bin/
*.test
*.out

# Web (SvelteKit + pnpm)
node_modules/
/web/build/
/web/.svelte-kit/
/web/.vite/
!/web/build/.gitkeep

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
